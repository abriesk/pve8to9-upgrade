jrows() { perl -MJSON::PP -0777 -ne 'my $d = eval { decode_json($_) }; die "not JSON\n" unless defined $d; for my $o (ref $d eq "ARRAY" ? @$d : ($d)) { '"$1"' }'; }
tokens() {    # the NAMES of every API token (user!tokenid) - never a value; a user whose list fails is logged and skipped
