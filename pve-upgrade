    ns="$(jrows 'print "$o->{timestamp}\n"; last' <<<"$a" 2>/dev/null)" && [[ "$ns" =~ ^[0-9]+$ ]] \
      || stop backup-schedule "schedule-analyze for backup job $id: no next run in its answer: ${a:0:80}"
    chk backup-schedule "$(b [ $((ns - $(date +%s))) -gt $((BK_WINDOW_MIN * 60)) ])" "backup job $id runs at $(date -d "@$ns" '+%F %T %Z') - wait, or disable job $id for the upgrade AND re-enable it before recheck (recheck compares jobs.cfg to precheck's record)"
  done <<<"$o"
}
gates() {     # before to-8.4, upgrade and reboot: the run that cuts the service holds them, not only the run that began at precheck
  bootk
  bksched; vzrun; chk vzdump "$(b [ -z "$VZ" ])" "a vzdump task runs in the cluster: $VZ- never upgrade under a backup"
  [ "$NFS_SERVER" = yes ] || return 0
  [ "$NFSQ" = 1 ] || say "nfs server: confirm the share is idle (no backup job, no transfer running), then rerun with --nfs-quiet"
  chk nfs-quiet "$(b [ "$NFSQ" = 1 ])" "this node exports the share: confirm no node holds files on it, then --nfs-quiet (this run only)"
}
# name|command: what precheck records and recheck compares (backups, permissions; the NFS server's view)
BKREC=("pve-roles|roles" "pve-acl|acls" "pve-tokens|tokens" "pve-bkjobs|bkjobs" "pve-jobsmd5|jmd5")
NFSREC=("nfs-exports|q exportfs -v" "nfs-versions|cat $R/proc/fs/nfsd/versions 2>/dev/null" "nfs-conf|q nfsconf --dump"
  "nfs-rpc|rpcs" "nfs-exportmnt|expmnt")
expmnt() { local e; for e in $(q exportfs -v | awk '$1 ~ /^\//{print $1}' | sort -u); do q findmnt -n -T "$e"; echo; done; }
recall() { local x; for x in "$@"; do rec "${x%%|*}" "$(eval "${x#*|}")"; done; }
blnorm() { sed -E 's/[[:blank:]]+/ /g; s/ $//'; }   # runs of blanks -> one space, trailing blanks dropped: findmnt's column padding moved with util-linux; the record is never rewritten
oldtok_ok() {   # an older record held only token ids, of OLD_TOKEN_USER's tokens (profile key); no user set: every recorded id must still exist
  local live; live="$(tokens)"
  if [ -n "$OLD_TOKEN_USER" ]; then [ "$(awk -F'!' -v u="$OLD_TOKEN_USER" '$1==u{print $2}' <<<"$live" | sort | blnorm)" = "$(sort "$S/pve-tokens" | blnorm)" ]
  else [ -z "$(sed 's/^[^!]*!//' <<<"$live" | sort | comm -13 - <(sort "$S/pve-tokens" | grep .))" ]; fi; }
rediff() { local x; for x in "$@"; do   # a record precheck never made (state set by hand) is said, not failed
  [ -f "$S/${x%%|*}" ] || { say "recheck: no record ${x%%|*}"; continue; }
  if [ "${x%%|*}" = pve-tokens ] && grep -q . "$S/pve-tokens" && ! grep -q '!' "$S/pve-tokens"; then oldtok_ok || bad+=("pve-tokens differs from precheck's record"); continue; fi
  [ "$(eval "${x#*|}" | blnorm)" = "$(blnorm < "$S/${x%%|*}")" ] || bad+=("${x%%|*} differs from precheck's record"); done; }
bk_pre() {    # never upgrade under a backup or with a setting PVE 9 drops
  local m; m="$(grep -lE '^[[:space:]]*maxfiles' "$R/etc/pve/jobs.cfg" "$R/etc/pve/storage.cfg" "$R/etc/vzdump.conf" 2>/dev/null | tr '\n' ' ')"
  chk maxfiles "$(b [ -z "$m" ])" "maxfiles in $m- PVE 9 drops it: use prune-backups"
  vzrun; chk vzdump "$(b [ -z "$VZ" ])" "a vzdump task runs in the cluster: $VZ- never upgrade under a backup"
  if command -v pve8to9 > /dev/null; then
    o="$(p89)"; chk vm-monitor "$(grep '^FAIL:.*VM\.Monitor' <<<"$o" > /dev/null && echo 0 || echo 1)" "pve8to9: a custom role uses VM.Monitor - fix the role first"; fi
  later "records: ${BKREC[*]%%|*}" && recall "${BKREC[@]}"
}
nfs_pre() {
  later "records: nfs-mounts (findmnt -t nfs,nfs4)" && rec nfs-mounts "$(q findmnt -t nfs,nfs4 -o TARGET,OPTIONS)"
  [ "$NFS_SERVER" = yes ] || return 0
  later "records: ${NFSREC[*]%%|*}" && recall "${NFSREC[@]}"
  [ "$NFSQ" = 1 ] || say "nfs server: confirm the share is idle (no backup job, no transfer running), then rerun with --nfs-quiet"
  chk nfs-quiet "$(b [ "$NFSQ" = 1 ])" "this node exports the share: confirm no node holds files on it, then --nfs-quiet (one run)"
}
PROBEF=""; cleanp() { [ -z "$PROBEF" ] || timeout 5 rm -f -- "$PROBEF" 2>/dev/null; PROBEF=""; }
probe() {     # write/read/delete under the share, bounded: a timeout is a FAIL, never a wait; the file goes on every path
  local rc; PROBEF="$R$SHARED/.pve-upgrade-probe.$HOST.$$"; trap cleanp EXIT
  timeout 20 sh -c 'echo probe > "$1" && [ "$(cat "$1")" = probe ] && rm -f -- "$1"' sh "$PROBEF"; rc=$?; cleanp; return $rc; }
# options a newer kernel prints for an unchanged mount (7.0 adds fatal_neterrors=none after hard); any other new
# option still fails until a slice adds it here - fail-closed: an unknown option is a difference
NFS_IGNORE='^fatal_neterrors='
nfsnorm() {   # findmnt TARGET,OPTIONS lines -> target + options sorted, NFS_IGNORE dropped; the record file is never rewritten
  local t o; while read -r t o || [ -n "$t" ]; do   # q and rec drop the last newline
    printf '%s %s\n' "$t" "$(tr , '\n' <<<"$o" | grep -vE "$NFS_IGNORE" | sort | paste -sd, -)"; done; }
bkn_re() {    # recheck: appends to bad[]
  rediff "${BKREC[@]}"
  if [ -n "$SHARED" ]; then
    [ ! -f "$S/nfs-mounts" ] || [ "$(q findmnt -t nfs,nfs4 -o TARGET,OPTIONS | nfsnorm)" = "$(nfsnorm < "$S/nfs-mounts")" ] || bad+=("nfs mounts differ from precheck's record")
    local sn="${SHARED##*/}"
    if [ "$(q pvesm status | awk -v n="$sn" '$1 == n {print $3}')" = active ]; then
      probe || bad+=("$SHARED: write/read/delete probe failed or timed out (20 s)")
    else bad+=("pvesm: storage $sn not active"); fi
  else say "nfs: skipped: no SHARED"; fi
  [ "$NFS_SERVER" = yes ] || return 0
  rediff "${NFSREC[@]}"
  for u in nfs-server rpcbind nfs-mountd; do q systemctl is-active "$u" > /dev/null || bad+=("$u not active"); done
}
ph_recheck() {
  local bad=() n u f nic o
  p89_ok || bad+=("pve8to9: $P89")
  quorate || bad+=("pvecm: not quorate")
  if [ -f "$S/expect-kernel" ]; then o="$(q uname -r)"   # the kernel reboot_now expected; no record is said, not failed (rediff's rule)
    [ "$o" = "$(cat "$S/expect-kernel")" ] || bad+=("booted $o, expected $(cat "$S/expect-kernel")")
  else say "recheck: no record expect-kernel"; fi
  if [ "${GPU:-}" = yes ] && [ "$GPUS" = 0 ]; then say "recheck: no GPU on this host - module checks only"
    if ! u="$(newk)"; then bad+=("dkms: cannot read the kernel list"); else dkms_ok "$u" || bad+=("dkms: nvidia not built for $u"); fi
    ls "$R/lib/modules/$(q uname -r)/updates/dkms/"nvidia.ko* > /dev/null 2>&1 || bad+=("no nvidia.ko for $(q uname -r)")
  elif [ "${GPU:-}" = yes ]; then
    n="$(q nvidia-smi -L | grep -c '^GPU ')"; [ "$n" -ge "$GPUS" ] || bad+=("nvidia-smi: $n GPU(s), profile has $GPUS")
    q systemctl is-active nvidia-persistenced > /dev/null || bad+=("nvidia-persistenced not active")
    n="$(q nvidia-smi -q | grep -cE '^[[:space:]]*Persistence Mode[[:space:]]*: Enabled')"
    [ "$n" -ge "$GPUS" ] || bad+=("persistence mode enabled on $n card(s), profile has $GPUS")
  else say "recheck: GPU lines skipped (driver decision ${GPU:-none})"; fi
  for nic in $NICS; do
    o="$(q ethtool -k "$nic")"
    for f in tcp-segmentation-offload generic-segmentation-offload generic-receive-offload; do
      grep "^$f: off" <<<"$o" > /dev/null || bad+=("$nic: $f not off")
    done
  done
  [ -z "$SHARED" ] || q findmnt -n "$SHARED" > /dev/null || bad+=("$SHARED not mounted")
  for u in $UNITS; do unit_re "$u"; done
  for f in $FILES; do [ -e "$R$f" ] || bad+=("$f missing"); done
  if o="$(q systemctl --failed --no-legend --plain)"; then   # a unit masked after it failed stays listed until reset-failed
    f="$(cat "$S/failed-units" 2>/dev/null)"; n=""
    for u in $(awk '{print ($1 == "●" ? $2 : $1)}' <<<"$o"); do
      case " $f " in *" $u "*) say "already failed before (precheck's record): $u";; *) n+="$u ";; esac; done
    [ -z "$n" ] || bad+=("failed-units: ${n% }")
  else bad+=("systemctl --failed unreadable"); fi
  [ -z "$ZFS_POOL" ] || zfs_re
  if later "backups, permissions, NFS match precheck's records"; then bkn_re; fi
  if [ "$APPLY" = 1 ]; then repos_re
  else echo "  would: recheck apt-get update (no Err:/W:/E:/Ignoring file), proxmox-ve's candidate from download.proxmox.com trixie/pve-no-subscription, no enabled bookworm or enterprise source"; fi
  if [ "${#bad[@]}" -gt 0 ]; then
    printf '  FAIL %s\n' "${bad[@]}"; logl "recheck failures: ${bad[*]}"
    [ "$APPLY" = 1 ] && { echo "STOP recheck: ${#bad[@]} failure(s): ${bad[*]}" >&2; exit 1; }
    DRYFAIL=1; return 0
  fi
  echo "RECHECK OK $HOST"; logl "RECHECK OK $HOST"
}

DRYFAIL=0; GPU=""; RAN=0   # RAN: a phase ran in this invocation (a rerun that starts at reboot does not pause again)
last="$(cat "$STATE" 2>/dev/null)"; done_idx=-1
for i in "${!PHASES[@]}"; do [ "${PHASES[$i]}" = "$last" ] && done_idx=$i; done
DUE="${PHASES[$((done_idx + 1))]:-}"
fetch_idx=-1; for i in "${!PHASES[@]}"; do [ "${PHASES[$i]}" = fetch ] && fetch_idx=$i; done
up_idx=-1; for i in "${!PHASES[@]}"; do [ "${PHASES[$i]}" = upgrade ] && up_idx=$i; done
REPROBE=0; [ "$WHAT" = fetch ] && [ "$done_idx" -ge "$fetch_idx" ] && [ "$done_idx" -lt "$up_idx" ] && [ "$fetch_idx" -ge 0 ] && REPROBE=1   # past fetch, before upgrade: fetch may only re-record $S/repos
if [ "$APPLY" = 1 ]; then
  mkdir -p "$S"; logl "start: $HOST $WHAT --apply (state ${last:-none})"
  if [ "$REPROBE" = 1 ]; then PH=fetch; guards; repos_fetch; say "repos re-probed and re-recorded in $S/repos; state stays ${last}"; exit 0; fi
  [ "$NFSQ" = 0 ] || logl "APPLY --nfs-quiet: the operator confirmed the share idle - this run only"
  PH="${DUE:-recheck}"
  [ -n "$DUE" ] || { [ "$WHAT" = all ] && { echo "every phase done (state $last)"; exit 0; }; stop order "every phase is done - nothing to run"; }
  [ "$WHAT" = all ] || [ "$WHAT" = "$DUE" ] || stop order "the next due phase is $DUE, not $WHAT - state moves forward only"
  guards
else
  echo "DRY RUN (no --apply): nothing is changed - $HOST ($NAME), nvidia=$NVIDIA"
  PH=driver; gpu_decide
fi
for i in "${!PHASES[@]}"; do
  PH="${PHASES[$i]}"
  [ "$WHAT" = all ] || [ "$WHAT" = "$PH" ] || continue
  if [ "$WHAT" = all ] && [ "$i" -le "$done_idx" ]; then [ "$APPLY" = 1 ] || echo "== $PH (done)"; continue; fi
  if [ "$APPLY" = 1 ] && [ "$WHAT" = all ] && [ "$PH" = reboot ] && [ "$THRU" = 0 ] && [ "$RAN" = 1 ]; then   # the reboot is announced first: ssh is down during the dist-upgrade
    echo "NEXT reboot: announce it, then \`./pve-upgrade $HOST reboot --apply\` (or all --apply)"; logl "pause before reboot (state driver)"; exit 0
  fi
  echo "== $PH"; logl "phase $PH"; RAN=1
  if [ "$APPLY" = 1 ] && [[ ! "$PH" =~ ^(precheck|preclean|fetch|drain|recheck)$ ]]; then running; fi   # drain is `running` itself; fetch and preclean (kernels via apt, lists backups, touches no guest) run beside guests
  if [ "$APPLY" = 1 ] && [[ "$PH" =~ ^(to-8.4|upgrade|reboot)$ ]]; then gates; fi
  case "$PH" in to-8.4) ph_to84;; *) "ph_$PH";; esac
  if [ "$APPLY" = 1 ]; then wr "$STATE" "$PH"; logl "phase $PH done"; [ "$PH" != precheck ] || wr "$S/failed-units" "$FU"; fi
done
[ "$APPLY" = 1 ] && exit 0
[ "$DRYFAIL" = 0 ] && { echo "dry run: every check that can run now passed"; exit 0; }
echo "dry run: FAIL lines above"; exit 1
